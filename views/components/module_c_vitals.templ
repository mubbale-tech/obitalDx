package components

templ ModuleCVitals() {
	<div id="module-c" class="rounded-2xl bg-slate-900/80 border border-slate-800/90 p-4 sm:p-5 shadow-xl space-y-4">
		<!-- Header -->
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div class="flex items-center gap-2">
				<span class="px-2 py-0.5 rounded text-[11px] font-mono font-bold uppercase bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">
					MODULE C
				</span>
				<h2 class="font-display text-base font-bold text-white">
					Vitals Entry &amp; 1-Click "Simulate Anomaly" Engine
				</h2>
			</div>
			<span class="text-[11px] font-mono text-emerald-400">● REAL-TIME ENGINE READY</span>
		</div>

		<!-- 1-CLICK DEMO SCENARIOS -->
		<div class="space-y-2">
			<div class="flex items-center justify-between text-[11px] font-mono uppercase text-slate-400">
				<span>⚡ 1-CLICK JUDGE / PITCH DEMO SCENARIOS</span>
				<span class="text-cyan-400" x-text="'ACTIVE: ' + state.vitals.scenario_id.toUpperCase()"></span>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
				<template x-for="sc in scenarios" :key="sc.id">
					<button
						type="button"
						@click="triggerScenario(sc.id)"
						class="text-left p-2.5 rounded-xl border transition-all cursor-pointer group"
						:class="state.vitals.scenario_id === sc.id
							? 'bg-cyan-950/60 border-cyan-400/80 shadow-md shadow-cyan-500/10'
							: 'bg-slate-950/80 border-slate-800 hover:border-slate-700'"
					>
						<div class="flex items-center justify-between gap-1">
							<span class="font-display text-xs font-bold text-white group-hover:text-cyan-300 transition" x-text="sc.name"></span>
							<span
								class="px-1.5 py-0.5 rounded text-[9px] font-mono font-bold uppercase"
								:class="{
									'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40': sc.tier === 'GREEN',
									'bg-amber-500/20 text-amber-300 border border-amber-500/40': sc.tier === 'AMBER',
									'bg-rose-500/25 text-rose-300 border border-rose-500/50': sc.tier === 'RED'
								}"
								x-text="sc.badge"
							></span>
						</div>
						<p class="text-[11px] text-slate-400 mt-1 line-clamp-2" x-text="sc.description"></p>
					</button>
				</template>
			</div>
		</div>

		<!-- MANUAL ASTRONAUT VITALS CHECK-IN FORM -->
		<form @submit.prevent="submitVitals()" class="pt-3 border-t border-slate-800/90 space-y-3">
			<div class="flex items-center justify-between">
				<span class="text-[11px] font-mono uppercase text-slate-400 font-semibold">
					🩺 MANUAL CREW VITALS &amp; DOSIMETRY CHECK-IN
				</span>
				<span class="text-[10px] font-mono text-slate-500">Adjust any value to re-triage</span>
			</div>

			<div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 text-xs">
				<!-- Systolic BP -->
				<div class="p-2.5 rounded-xl bg-slate-950/90 border border-slate-800/90">
					<label class="block text-[10px] font-mono uppercase text-slate-400">Systolic BP (mmHg)</label>
					<div class="mt-1 flex items-center justify-between gap-2">
						<input
							type="number"
							min="70"
							max="190"
							x-model.number="form.systolic_bp"
							@change="submitVitals()"
							class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 font-mono text-sm font-bold text-white focus:border-cyan-400 focus:outline-none"
						/>
					</div>
					<span class="text-[10px] text-slate-500 font-mono">Norm: 105–125</span>
				</div>

				<!-- Diastolic BP -->
				<div class="p-2.5 rounded-xl bg-slate-950/90 border border-slate-800/90">
					<label class="block text-[10px] font-mono uppercase text-slate-400">Diastolic BP (mmHg)</label>
					<div class="mt-1 flex items-center justify-between gap-2">
						<input
							type="number"
							min="40"
							max="130"
							x-model.number="form.diastolic_bp"
							@change="submitVitals()"
							class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 font-mono text-sm font-bold text-white focus:border-cyan-400 focus:outline-none"
						/>
					</div>
					<span class="text-[10px] text-slate-500 font-mono">Norm: 65–82</span>
				</div>

				<!-- Heart Rate -->
				<div class="p-2.5 rounded-xl bg-slate-950/90 border border-slate-800/90">
					<label class="block text-[10px] font-mono uppercase text-slate-400">Heart Rate (bpm)</label>
					<div class="mt-1 flex items-center justify-between gap-2">
						<input
							type="number"
							min="40"
							max="165"
							x-model.number="form.heart_rate"
							@change="submitVitals()"
							class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 font-mono text-sm font-bold text-white focus:border-cyan-400 focus:outline-none"
						/>
					</div>
					<span class="text-[10px] text-slate-500 font-mono">Norm: 55–78 bpm</span>
				</div>

				<!-- Blood Sugar -->
				<div class="p-2.5 rounded-xl bg-slate-950/90 border border-slate-800/90">
					<label class="block text-[10px] font-mono uppercase text-slate-400">Blood Sugar (mg/dL)</label>
					<div class="mt-1 flex items-center justify-between gap-2">
						<input
							type="number"
							min="50"
							max="280"
							x-model.number="form.blood_sugar"
							@change="submitVitals()"
							class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 font-mono text-sm font-bold text-white focus:border-cyan-400 focus:outline-none"
						/>
					</div>
					<span class="text-[10px] text-slate-500 font-mono">Norm: 75–105 mg/dL</span>
				</div>

				<!-- Body Temperature -->
				<div class="p-2.5 rounded-xl bg-slate-950/90 border border-slate-800/90">
					<label class="block text-[10px] font-mono uppercase text-slate-400">Body Temp (°C)</label>
					<div class="mt-1 flex items-center justify-between gap-2">
						<input
							type="number"
							step="0.1"
							min="35.0"
							max="40.5"
							x-model.number="form.body_temp"
							@change="submitVitals()"
							class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 font-mono text-sm font-bold text-white focus:border-cyan-400 focus:outline-none"
						/>
					</div>
					<span class="text-[10px] text-slate-500 font-mono">Norm: 36.3–37.2°C</span>
				</div>

				<!-- Daily Sleep Hours -->
				<div class="p-2.5 rounded-xl bg-slate-950/90 border border-slate-800/90">
					<label class="block text-[10px] font-mono uppercase text-slate-400">Sleep Hours (24h)</label>
					<div class="mt-1 flex items-center justify-between gap-2">
						<input
							type="number"
							step="0.1"
							min="1.0"
							max="12.0"
							x-model.number="form.sleep_hours"
							@change="submitVitals()"
							class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 font-mono text-sm font-bold text-white focus:border-cyan-400 focus:outline-none"
						/>
					</div>
					<span class="text-[10px] text-slate-500 font-mono">Norm: 7.0–8.5 hrs</span>
				</div>

				<!-- Mood / Stress Score (1-10) -->
				<div class="p-2.5 rounded-xl bg-slate-950/90 border border-slate-800/90">
					<label class="block text-[10px] font-mono uppercase text-slate-400">Mood Readiness (1–10)</label>
					<div class="mt-1 flex items-center justify-between gap-2">
						<input
							type="number"
							min="1"
							max="10"
							x-model.number="form.mood_score"
							@change="submitVitals()"
							class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 font-mono text-sm font-bold text-white focus:border-cyan-400 focus:outline-none"
						/>
					</div>
					<span class="text-[10px] text-slate-500 font-mono">Norm: 7–10 Score</span>
				</div>

				<!-- Radiation Exposure (mSv/day) -->
				<div class="p-2.5 rounded-xl bg-slate-950/90 border border-purple-500/40">
					<label class="block text-[10px] font-mono uppercase text-purple-300">Radiation (mSv/day)</label>
					<div class="mt-1 flex items-center justify-between gap-2">
						<input
							type="number"
							step="0.05"
							min="0.1"
							max="25.0"
							x-model.number="form.radiation_msv"
							@change="submitVitals()"
							class="w-full bg-slate-900 border border-purple-500/50 rounded-lg px-2 py-1 font-mono text-sm font-bold text-purple-200 focus:border-purple-400 focus:outline-none"
						/>
					</div>
					<span class="text-[10px] text-purple-300/80 font-mono">CSA CANS Linked</span>
				</div>

				<!-- ARED Compliance (%) & Cabin CO2 -->
				<div class="p-2.5 rounded-xl bg-slate-950/90 border border-slate-800/90">
					<label class="block text-[10px] font-mono uppercase text-slate-400">ARED Load (%) / CO₂</label>
					<div class="mt-1 grid grid-cols-2 gap-1.5">
						<input
							type="number"
							min="0"
							max="100"
							title="ARED Resistive Exercise Compliance %"
							x-model.number="form.ared_compliance"
							@change="submitVitals()"
							class="w-full bg-slate-900 border border-slate-700 rounded-lg px-1.5 py-1 font-mono text-xs font-bold text-white focus:border-cyan-400 focus:outline-none"
						/>
						<input
							type="number"
							step="0.1"
							min="0.5"
							max="8.0"
							title="Cabin ppCO2 (mmHg)"
							x-model.number="form.cabin_co2"
							@change="submitVitals()"
							class="w-full bg-slate-900 border border-slate-700 rounded-lg px-1.5 py-1 font-mono text-xs font-bold text-cyan-300 focus:border-cyan-400 focus:outline-none"
						/>
					</div>
					<span class="text-[10px] text-slate-500 font-mono">ARED ≥85% | CO₂ &lt;3.2</span>
				</div>
			</div>

			<div class="flex items-center justify-between gap-3 pt-1">
				<button
					type="submit"
					class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-display font-bold text-xs uppercase tracking-wider shadow-lg shadow-cyan-500/20 transition cursor-pointer"
				>
					⚡ Run Autonomous Clinical Triage &amp; Update 30-Day Telemetry
				</button>
			</div>
		</form>
	</div>
}
