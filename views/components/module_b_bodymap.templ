package components

templ ModuleBBodyMap() {
	<div id="module-b" class="rounded-2xl bg-slate-900/80 border border-slate-800/90 p-4 sm:p-5 shadow-xl space-y-4">
		<!-- Header -->
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div class="flex items-center gap-2">
				<span class="px-2 py-0.5 rounded text-[11px] font-mono font-bold uppercase bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">
					MODULE B
				</span>
				<h2 class="font-display text-base font-bold text-white">
					Interactive Human Body Telemetry Twin
				</h2>
			</div>
			<button
				type="button"
				@click="activeSystem = 'all'"
				class="px-2.5 py-1 rounded-lg text-[11px] font-mono transition cursor-pointer border"
				:class="activeSystem === 'all' ? 'bg-cyan-500 text-slate-950 font-bold border-cyan-400' : 'bg-slate-950 text-slate-300 border-slate-800 hover:border-cyan-500/40'"
			>
				Show All 4 Systems
			</button>
		</div>

		<p class="text-xs text-slate-400">
			Click any glowing anatomical region on the bio-twin silhouette or system cards below to filter clinical triage &amp; countermeasures.
		</p>

		<!-- Interactive SVG Anatomical Bio-Twin Container -->
		<div class="relative rounded-xl bg-slate-950/95 border border-slate-800/90 p-4 flex flex-col items-center justify-center overflow-hidden">
			<!-- Radar Grid & Scanline Overlay -->
			<div class="absolute inset-0 pointer-events-none opacity-25" style="background-image: radial-gradient(circle at 50% 45%, rgba(34,211,238,0.18), transparent 70%);"></div>

			<!-- Top HUD Labels Inside Bio-Twin -->
			<div class="w-full flex items-center justify-between text-[10px] font-mono text-slate-400 mb-1 z-10">
				<span>BIO-TWIN TELEMETRY: <strong class="text-cyan-300">CREW-01 (CMO)</strong></span>
				<span x-text="'FILTER: ' + activeSystemLabel()"></span>
			</div>

			<!-- SVG ANATOMICAL SILHOUETTE WITH CLICKABLE HOTSPOTS -->
			<svg viewBox="0 0 280 420" class="w-full max-w-[265px] h-auto select-none z-10">
				<defs>
					<radialGradient id="hudGlow" cx="50%" cy="50%" r="50%">
						<stop offset="0%" stop-color="#22d3ee" stop-opacity="0.25"></stop>
						<stop offset="100%" stop-color="#0f172a" stop-opacity="0"></stop>
					</radialGradient>
				</defs>

				<!-- Base Target Rings -->
				<circle cx="140" cy="210" r="125" fill="url(#hudGlow)" stroke="#1e293b" stroke-width="1" stroke-dasharray="4 4"></circle>
				<ellipse cx="140" cy="395" rx="75" ry="12" fill="none" stroke="#0ea5e9" stroke-opacity="0.35" stroke-width="1.5"></ellipse>

				<!-- Full Astronaut Anatomical Silhouette Outline -->
				<g stroke="#38bdf8" stroke-opacity="0.45" stroke-width="1.6" fill="#0f172a" fill-opacity="0.75">
					<!-- Head & Neck -->
					<path d="M140 24 C122 24 112 38 112 56 C112 72 121 84 128 90 L128 102 L152 102 L152 90 C159 84 168 72 168 56 C168 38 158 24 140 24 Z"></path>
					<!-- Torso & Arms -->
					<path d="M128 102 L92 114 C80 118 74 130 72 146 L64 228 C62 238 69 244 76 242 L84 240 L94 158 L102 158 L102 238 L178 238 L178 158 L186 158 L196 240 L204 242 C211 244 218 238 216 228 L208 146 C206 130 200 118 188 114 L152 102 Z"></path>
					<!-- Pelvis & Legs -->
					<path d="M102 238 L108 380 C108 388 116 392 124 390 L132 388 L136 276 L144 276 L148 388 L156 390 C164 392 172 388 172 380 L178 238 Z"></path>
				</g>

				<!-- ============================================================ -->
				<!-- ZONE 4: BLOOD, IMMUNE & RADIATION VASCULAR / MARROW NETWORK  -->
				<!-- ============================================================ -->
				<g
					@click="toggleSystem('blood')"
					class="cursor-pointer transition-opacity"
					:class="activeSystem === 'all' || activeSystem === 'blood' ? 'opacity-100' : 'opacity-40 hover:opacity-80'"
				>
					<!-- Arterial/Venous & Pelvic Bone Marrow Shielding Paths -->
					<path
						d="M140 145 L140 245 M140 165 L82 215 M140 165 L198 215 M140 245 L118 345 M140 245 L162 345"
						fill="none"
						:stroke="systemStrokeColor('blood')"
						stroke-width="2.5"
						stroke-dasharray="3 3"
					></path>
					<!-- Pelvic Hematopoietic Marrow & Radiation Node -->
					<circle
						cx="140"
						cy="232"
						r="17"
						:fill="systemFillColor('blood')"
						:stroke="systemStrokeColor('blood')"
						stroke-width="2"
					></circle>
					<text x="140" y="236" text-anchor="middle" fill="#ffffff" font-size="9" font-family="monospace" font-weight="bold">☢️ CANS</text>
					<!-- Callout Line right -->
					<line x1="157" y1="232" x2="215" y2="232" :stroke="systemStrokeColor('blood')" stroke-width="1.2"></line>
					<rect x="200" y="218" width="76" height="24" rx="4" fill="#020617" :stroke="systemStrokeColor('blood')" stroke-width="1"></rect>
					<text x="238" y="229" text-anchor="middle" fill="#e2e8f0" font-size="7.5" font-family="monospace" font-weight="bold">4. BLOOD/RAD</text>
					<text x="238" y="238" text-anchor="middle" :fill="systemStrokeColor('blood')" font-size="7" font-family="monospace" x-text="systemTier('blood')"></text>
				</g>

				<!-- ============================================================ -->
				<!-- ZONE 3: SKELETON & MUSCLES (SPINE, FEMUR & JOINTS)           -->
				<!-- ============================================================ -->
				<g
					@click="toggleSystem('skeleton')"
					class="cursor-pointer transition-opacity"
					:class="activeSystem === 'all' || activeSystem === 'skeleton' ? 'opacity-100' : 'opacity-40 hover:opacity-80'"
				>
					<!-- Lumbar Spine & Femoral Shafts -->
					<line x1="140" y1="110" x2="140" y2="215" :stroke="systemStrokeColor('skeleton')" stroke-width="4" stroke-dasharray="5 3"></line>
					<line x1="122" y1="265" x2="118" y2="365" :stroke="systemStrokeColor('skeleton')" stroke-width="5" stroke-linecap="round"></line>
					<line x1="158" y1="265" x2="162" y2="365" :stroke="systemStrokeColor('skeleton')" stroke-width="5" stroke-linecap="round"></line>
					<!-- Femur/Knee Hotspot Node -->
					<circle
						cx="120"
						cy="312"
						r="15"
						:fill="systemFillColor('skeleton')"
						:stroke="systemStrokeColor('skeleton')"
						stroke-width="2"
					></circle>
					<text x="120" y="315" text-anchor="middle" fill="#ffffff" font-size="8.5" font-family="monospace" font-weight="bold">BMD</text>
					<!-- Callout Line left -->
					<line x1="105" y1="312" x2="78" y2="312" :stroke="systemStrokeColor('skeleton')" stroke-width="1.2"></line>
					<rect x="4" y="298" width="76" height="24" rx="4" fill="#020617" :stroke="systemStrokeColor('skeleton')" stroke-width="1"></rect>
					<text x="42" y="309" text-anchor="middle" fill="#e2e8f0" font-size="7.5" font-family="monospace" font-weight="bold">3. SKELETON</text>
					<text x="42" y="318" text-anchor="middle" :fill="systemStrokeColor('skeleton')" font-size="7" font-family="monospace" x-text="systemTier('skeleton')"></text>
				</g>

				<!-- ============================================================ -->
				<!-- ZONE 2: HEART & CHEST (CARDIOVASCULAR & RESPIRATORY)         -->
				<!-- ============================================================ -->
				<g
					@click="toggleSystem('heart')"
					class="cursor-pointer transition-opacity"
					:class="activeSystem === 'all' || activeSystem === 'heart' ? 'opacity-100' : 'opacity-40 hover:opacity-80'"
				>
					<!-- Dual Lung Lobes -->
					<path d="M114 122 C108 132 108 162 116 172 L134 172 L134 122 Z" :fill="systemFillColor('heart')" :stroke="systemStrokeColor('heart')" stroke-width="1.5"></path>
					<path d="M166 122 C172 132 172 162 164 172 L146 172 L146 122 Z" :fill="systemFillColor('heart')" :stroke="systemStrokeColor('heart')" stroke-width="1.5"></path>
					<!-- Cardiac Core Node -->
					<circle
						cx="144"
						cy="148"
						r="16"
						:fill="systemFillColor('heart')"
						:stroke="systemStrokeColor('heart')"
						stroke-width="2.2"
					></circle>
					<!-- ECG Waveform Icon Inside Heart -->
					<polyline points="133,148 139,148 142,140 146,156 149,145 155,148" fill="none" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></polyline>
					<!-- Callout Line left -->
					<line x1="110" y1="148" x2="78" y2="148" :stroke="systemStrokeColor('heart')" stroke-width="1.2"></line>
					<rect x="4" y="134" width="76" height="24" rx="4" fill="#020617" :stroke="systemStrokeColor('heart')" stroke-width="1"></rect>
					<text x="42" y="145" text-anchor="middle" fill="#e2e8f0" font-size="7.5" font-family="monospace" font-weight="bold">2. HEART/LUNG</text>
					<text x="42" y="154" text-anchor="middle" :fill="systemStrokeColor('heart')" font-size="7" font-family="monospace" x-text="systemTier('heart')"></text>
				</g>

				<!-- ============================================================ -->
				<!-- ZONE 1: HEAD & EYES (NEURO-OCULAR SANS & BEHAVIORAL)         -->
				<!-- ============================================================ -->
				<g
					@click="toggleSystem('head')"
					class="cursor-pointer transition-opacity"
					:class="activeSystem === 'all' || activeSystem === 'head' ? 'opacity-100' : 'opacity-40 hover:opacity-80'"
				>
					<circle
						cx="140"
						cy="56"
						r="22"
						:fill="systemFillColor('head')"
						:stroke="systemStrokeColor('head')"
						stroke-width="2.2"
					></circle>
					<!-- Ocular / Optic Nerve Nodes -->
					<circle cx="131" cy="54" r="3.5" fill="#ffffff"></circle>
					<circle cx="149" cy="54" r="3.5" fill="#ffffff"></circle>
					<path d="M131 58 L140 70 L149 58" fill="none" stroke="#38bdf8" stroke-width="1.4"></path>
					<!-- Callout Line right -->
					<line x1="162" y1="56" x2="198" y2="56" :stroke="systemStrokeColor('head')" stroke-width="1.2"></line>
					<rect x="198" y="42" width="78" height="24" rx="4" fill="#020617" :stroke="systemStrokeColor('head')" stroke-width="1"></rect>
					<text x="237" y="53" text-anchor="middle" fill="#e2e8f0" font-size="7.5" font-family="monospace" font-weight="bold">1. HEAD/EYES</text>
					<text x="237" y="62" text-anchor="middle" :fill="systemStrokeColor('head')" font-size="7" font-family="monospace" x-text="systemTier('head')"></text>
				</g>
			</svg>

			<!-- Bottom Legend inside Bio-Twin -->
			<div class="w-full pt-2 mt-2 border-t border-slate-800/80 flex items-center justify-between text-[11px] font-mono">
				<span class="flex items-center gap-1.5 text-emerald-400"><span class="w-2 h-2 rounded-full bg-emerald-400"></span>NOMINAL</span>
				<span class="flex items-center gap-1.5 text-amber-300"><span class="w-2 h-2 rounded-full bg-amber-400"></span>WATCH / DRIFT</span>
				<span class="flex items-center gap-1.5 text-rose-400"><span class="w-2 h-2 rounded-full bg-rose-500"></span>CMO ESCALATE</span>
			</div>
		</div>

		<!-- 4 Clickable System Filter Cards -->
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
			<template x-for="sys in state.body_systems" :key="sys.id">
				<button
					type="button"
					@click="toggleSystem(sys.id)"
					class="text-left p-3 rounded-xl border transition-all cursor-pointer"
					:class="activeSystem === sys.id
						? 'bg-cyan-950/50 border-cyan-400/80 shadow-md shadow-cyan-500/10'
						: 'bg-slate-950/75 border-slate-800/90 hover:border-slate-700'"
				>
					<div class="flex items-center justify-between gap-1.5">
						<span class="font-display text-xs font-bold text-white" x-text="sys.name"></span>
						<span
							class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold uppercase"
							:class="{
								'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40': sys.tier === 'GREEN',
								'bg-amber-500/20 text-amber-300 border border-amber-500/40': sys.tier === 'AMBER',
								'bg-rose-500/25 text-rose-300 border border-rose-500/50 animate-pulse': sys.tier === 'RED'
							}"
							x-text="sys.tier"
						></span>
					</div>
					<div class="text-[11px] text-slate-400 mt-0.5" x-text="sys.subtitle"></div>
					<div class="mt-2 pt-1.5 border-t border-slate-800/80 font-mono text-[11px] text-cyan-300 font-semibold truncate" x-text="sys.headline_metric"></div>
				</button>
			</template>
		</div>

		<!-- DEDICATED CSA CANS (CANADIAN ACTIVE NEUTRON SPECTROMETER) WIDGET -->
		<div class="rounded-xl bg-gradient-to-br from-purple-950/40 via-slate-950 to-slate-950 border border-purple-500/40 p-3.5 space-y-2.5">
			<div class="flex items-center justify-between gap-2">
				<div class="flex items-center gap-2">
					<span class="text-base">🇨🇦</span>
					<div>
						<div class="text-xs font-mono font-bold uppercase text-purple-300">
							CSA CANS — Canadian Active Neutron Spectrometer
						</div>
						<div class="text-[11px] text-slate-400" x-text="state.cans_neutron.spectrometer_status"></div>
					</div>
				</div>
				<span
					class="px-2 py-0.5 rounded text-xs font-mono font-bold bg-purple-500/20 text-purple-200 border border-purple-400/40"
					x-text="state.cans_neutron.neutron_percentage + '% Neutron Share'"
				></span>
			</div>

			<div class="grid grid-cols-3 gap-2 text-center font-mono text-xs pt-1">
				<div class="p-2 rounded-lg bg-slate-900/90 border border-slate-800">
					<span class="text-[10px] text-slate-400 block">TOTAL DOSE/DAY</span>
					<span class="text-sm font-bold text-white" x-text="state.cans_neutron.daily_total_msv + ' mSv'"></span>
				</div>
				<div class="p-2 rounded-lg bg-slate-900/90 border border-purple-500/40">
					<span class="text-[10px] text-purple-300 block">CANS NEUTRONS</span>
					<span class="text-sm font-bold text-purple-300" x-text="state.cans_neutron.daily_neutron_msv + ' mSv'"></span>
				</div>
				<div class="p-2 rounded-lg bg-slate-900/90 border border-slate-800">
					<span class="text-[10px] text-slate-400 block">FAST (&gt;100 keV)</span>
					<span class="text-sm font-bold text-rose-300" x-text="state.cans_neutron.fast_neutron_flux + ' mSv'"></span>
				</div>
			</div>

			<div class="text-[11px] text-slate-300 leading-relaxed" x-text="state.mission.cans_neutron_note"></div>
		</div>
	</div>
}
