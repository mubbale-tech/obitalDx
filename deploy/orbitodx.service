[Unit]
Description=OrbitoDX — Autonomous Crew Health Triage & Countermeasure Software (NASA HRP & CSA)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/orbitodx
ExecStart=/opt/orbitodx/orbitodx --host 0.0.0.0 --port 8080
Restart=always
RestartSec=2
Environment=PORT=8080

[Install]
WantedBy=multi-user.target
